class ImportStorageListAPI(generics.ListCreateAPIView):
    parser_classes = (JSONParser, FormParser, MultiPartParser)
    permission_required = all_permissions.projects_change
    serializer_class = ImportStorageSerializer

    def get_queryset(self):
        project_pk = self.request.query_params.get('project')
        if not project_pk:
            # Fix: Return empty queryset if no project is specified to prevent listing all storages
            logger.warning(f"User {self.request.user.id} attempted to list storages without project ID")
            return self.serializer_class.Meta.model.objects.none()

        try:
            project = get_object_with_check_and_log(self.request, Project, pk=project_pk)
            # Fix: Explicitly check organization permissions
            if not permission_org(self.request.user, project):
                logger.warning(f"User {self.request.user.id} lacks permission for project {project_pk}")
                raise PermissionDenied("User lacks organization permissions")
            self.check_object_permissions(self.request, project)
            ImportStorageClass = self.serializer_class.Meta.model
            # Fix: Filter by project and user’s organization
            return ImportStorageClass.objects.filter(project=project, org_id=project.organization_id)
        except Project.DoesNotExist:
            logger.warning(f"User {self.request.user.id} requested non-existent project {project_pk}")
            raise NotFound("Project not found")

    def post(self, request, *args, **kwargs):
        project_id = self.request.data.get('project')
        if not project_id:
            raise ValidationError("Project ID is required", code=400)

        try:
            project = Project.objects.get(id=project_id)
            # Fix: Check organization permissions
            if not permission_org(self.request.user, project):
                logger.warning(f"User {self.request.user.id} lacks permission to create storage for project {project_id}")
                raise PermissionDenied("User lacks organization permissions")
                
            check_org_admin = OrganizationMember.objects.filter(
                organization_id=project.organization_id,
                user_id=self.request.user.id,
                is_admin=True
            ).exists()
            
            if not check_org_admin and not self.request.user.is_superuser:
                raise ValidationError("You do not have permission to setup this project", code=403)

            serializer = self.get_serializer(data=self.request.data)
            serializer.is_valid(raise_exception=True)
            storage = serializer.save()

            # Sync logic for another storage
            def sync_another_storage(storage):
                try:
                    storage.create_folder(f"raw_files_{project.pk}")
                except Exception as e:
                    logger.error(f"Error syncing storage for project {project.pk}: {e}")

            import threading
            storage_thread = threading.Thread(target=sync_another_storage, args=(storage,))
            storage_thread.start()

            return Response(self.serializer_class(storage).data)
        except Project.DoesNotExist:
            logger.warning(f"User {self.request.user.id} requested non-existent project {project_id}")
            raise NotFound("Project not found")

class ImportStorageDetailAPI(generics.RetrieveUpdateDestroyAPIView):
    """RUD storage by pk specified in URL"""
    parser_classes = (JSONParser, FormParser, MultiPartParser)
    serializer_class = ImportStorageSerializer
    permission_required = all_permissions.projects_change
    permission_classes = [IsSuperAdminOrg]

    def get_queryset(self):
        # Fix: Restrict queryset to storages accessible by user’s organization
        ImportStorageClass = self.serializer_class.Meta.model
        if self.request.user.is_superuser:
            return ImportStorageClass.objects.all()
        return ImportStorageClass.objects.filter(
            org_id__in=OrganizationMember.objects.filter(
                user_id=self.request.user.id
            ).values('organization_id')
        )

    def get_object(self):
        obj = super().get_object()
        # Fix: Strengthen permission check to prevent IDOR
        if not permission_org(self.request.user, obj.project):
            logger.warning(
                f"User {self.request.user.id} attempted unauthorized access to storage {obj.id} for project {obj.project.id}"
            )
            raise PermissionDenied("User lacks organization permissions")
        return obj

    @swagger_auto_schema(auto_schema=None)
    def put(self, request, *args, **kwargs):
        return super().put(request, *args, **kwargs)

class ExportStorageListAPI(generics.ListCreateAPIView):
    parser_classes = (JSONParser, FormParser, MultiPartParser)
    permission_required = all_permissions.projects_change
    serializer_class = ExportStorageSerializer

    def get_queryset(self):
        project_pk = self.request.query_params.get('project')
        if not project_pk:
            # Fix: Return empty queryset if no project is specified
            logger.warning(f"User {self.request.user.id} attempted to list export storages without project ID")
            return self.serializer_class.Meta.model.objects.none()

        try:
            project = get_object_with_check_and_log(self.request, Project, pk=project_pk)
            # Fix: Explicitly check organization permissions
            if not permission_org(self.request.user, project):
                logger.warning(f"User {self.request.user.id} lacks permission for project {project_pk}")
                raise PermissionDenied("User lacks organization permissions")
            self.check_object_permissions(self.request, project)
            ExportStorageClass = self.serializer_class.Meta.model
            # Fix: Filter by project and user’s organization
            return ExportStorageClass.objects.filter(project_id=project.id, org_id=project.organization_id)
        except Project.DoesNotExist:
            logger.warning(f"User {self.request.user.id} requested non-existent project {project_pk}")
            raise NotFound("Project not found")

    def perform_create(self, serializer):
        if self.request.data.get('is_global') == 1 or self.request.data.get('project') == None:
            kwargs = self.request.data
            if kwargs.get('storage_type') == "s3":
                storage = S3ImportStorage(
                    title=kwargs.get('title'),
                    region_name=kwargs.get('region_name'),
                    bucket=kwargs.get('bucket'),
                    aws_access_key_id=kwargs.get('aws_access_key_id'),
                    aws_secret_access_key=kwargs.get('aws_secret_access_key'),
                    s3_endpoint=kwargs.get('s3_endpoint').strip(),
                    aws_session_token=kwargs.get('aws_session_token'),
                    use_blob_urls=True,
                    regex_filter=kwargs.get('regex_filter'),
                    is_global=True,
                    user_id=self.request.user.id,
                    project_id=kwargs.get('pk'),
                    org_id=self.request.user.active_organization_id
                )
                storage.validate_connection()
                storage.save()
                storage.refresh_from_db()
                return Response(status=200)
            elif kwargs.get('storage_type', "") == "azure":
                storage = AzureBlobImportStorage(
                    title=kwargs.get('title'),
                    container=kwargs.get('container'),
                    prefix=kwargs.get('prefix'),
                    regex_filter=kwargs.get('regex_filter'),
                    account_name=kwargs.get('account_name'),
                    account_key=kwargs.get('account_key'),
                    use_blob_urls=True,
                    is_global=True,
                    user_id=self.request.user.id,
                    org_id=self.request.user.active_organization_id,
                    project_id=kwargs.get('pk')
                )
                storage.validate_connection()
                storage.save()
                storage.refresh_from_db()
                return Response(status=200)
            elif kwargs.get('storage_type', "") == "redis":
                storage = RedisImportStorage(
                    title=kwargs.get('title'),
                    path=kwargs.get('path'),
                    host=kwargs.get('host'),
                    port=kwargs.get('port'),
                    password=kwargs.get('password'),
                    is_global=True,
                    user_id=self.request.user.id,
                    org_id=self.request.user.active_organization_id,
                    project_id=kwargs.get('pk')
                )
                storage.validate_connection()
                storage.save()
                storage.refresh_from_db()
                return Response(status=200)
            elif kwargs.get('storage_type', "") == "gdriver":
                storage = GDriverImportStorage(
                    title=kwargs.get('title'),
                    bucket=kwargs.get('bucket'),
                    prefix=kwargs.get('prefix'),
                    regex_filter=kwargs.get('regex'),
                    google_application_credentials=kwargs.get('google_application_credentials'),
                    use_blob_urls=True,
                    is_global=True,
                    user_id=self.request.user.id,
                    org_id=self.request.user.active_organization_id
                )
                storage.validate_connection()
                storage.save()
                storage.refresh_from_db()
                return Response(status=200)
            elif kwargs.get('storage_type', "") == "gcs":
                storage = GCSImportStorage(
                    title=kwargs.get('title'),
                    project=kwargs.get('pk'),
                    bucket=kwargs.get('bucket'),
                    prefix=kwargs.get('prefix'),
                    regex_filter=kwargs.get('regex_filter'),
                    google_application_credentials=kwargs.get('google_application_credentials'),
                    use_blob_urls=True,
                    is_global=True,
                    user_id=self.request.user.id,
                    org_id=self.request.user.active_organization_id
                )
                storage.validate_connection()
                storage.save()
                storage.refresh_from_db()
                return Response(status=200)
        else:
            project_id = self.request.data.get('project')
            if not project_id:
                raise ValidationError("Project ID is required", code=400)

            try:
                project = Project.objects.get(id=project_id)
                # Fix: Check organization permissions
                if not permission_org(self.request.user, project):
                    logger.warning(f"User {self.request.user.id} lacks permission to create export storage for project {project_id}")
                    raise PermissionDenied("User lacks organization permissions")
                    
                check_org_admin = OrganizationMember.objects.filter(
                    organization_id=project.organization_id,
                    user_id=self.request.user.id,
                    is_admin=True
                ).exists()
                if not check_org_admin:
                    if not project.organization.created_by_id == self.request.user.id and not self.request.user.is_superuser:
                        raise ValidationError("You do not have permission to setup this project", code=403)

                import_id = self.request.data.get("import_id")
                serializer = self.get_serializer(data=self.request.data)
                serializer.is_valid(raise_exception=True)
                storage = serializer.save()

                if import_id:
                    storage.create_connect_to_import_storage(import_id)

                if settings.SYNC_ON_TARGET_STORAGE_CREATION:
                    storage.sync()
            except Project.DoesNotExist:
                logger.warning(f"User {self.request.user.id} requested non-existent project {project_id}")
                raise NotFound("Project not found")

